exports[`разметка обычного пути (снимок до фичи 014) > лист «Самочувствие» с интенсивностью 1`] = `"<dialog class="sheet" tabindex="-1" aria-label="Самочувствие · 10 ноября" open=""><div class="sheet__body"><div class="sheet__grip" aria-hidden="true"></div><div class="sheet__head"><h2 class="t-card-title sheet__title">Самочувствие · 10 ноября</h2></div><fieldset class="chips"><legend class="visually-hidden">Самочувствие</legend><button type="button" class="chip" aria-pressed="false">Боль внизу живота</button><button type="button" class="chip" aria-pressed="true">Головная боль</button><button type="button" class="chip" aria-pressed="false">Боль в спине</button><button type="button" class="chip" aria-pressed="false">Вздутие</button><button type="button" class="chip" aria-pressed="false">Чувствительность груди</button><button type="button" class="chip" aria-pressed="false">Акне</button><button type="button" class="chip" aria-pressed="false">Усталость</button><button type="button" class="chip" aria-pressed="false">Тошнота</button><button type="button" class="chip" aria-pressed="false">Тяга к еде</button><button type="button" class="chip" aria-pressed="false">Бессонница</button></fieldset><div class="intensity"><p class="t-caption chips__legend">Интенсивность</p><fieldset class="intensity__row"><legend class="intensity__label">Головная боль</legend><div class="intensity__segments"><button type="button" class="segment" aria-pressed="false">слабо</button><button type="button" class="segment" aria-pressed="false">средне</button><button type="button" class="segment" aria-pressed="true">сильно</button></div></fieldset></div><button type="button" class="btn btn--primary">Готово</button></div></dialog>"`;

exports[`разметка обычного пути (снимок до фичи 014) > подсказка «Как получить прогноз» 1`] = `"<section class="hint" aria-labelledby="first-period-hint-title"><h2 id="first-period-hint-title" class="hint__title">Как получить прогноз</h2><p class="hint__text">Отметьте, когда начались последние месячные: нажмите на этот день в календаре — прошедшие дни тоже можно — и выберите «Начало месячных».</p><p class="hint__text">Историю из другого приложения можно загрузить в Настройках → «Резервная копия».</p><button type="button" class="icon-btn hint__close" aria-label="Скрыть подсказку"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M6 6l12 12M18 6 6 18"></path></svg></button></section>"`;

exports[`разметка обычного пути (снимок до фичи 014) > экран «Настройки» 1`] = `"<h1 class="t-screen-title screen__title">Настройки</h1><section class="card settings-card" aria-labelledby="cycle-title"><h2 id="cycle-title" class="t-card-title settings-card__title">Цикл</h2><p class="t-caption settings-card__text">Используются, пока не накопится история циклов.</p><div class="stepper"><span class="stepper__label">Длина цикла по умолчанию</span><div class="stepper__controls"><button type="button" class="icon-btn icon-btn--secondary" aria-label="Длина цикла по умолчанию: меньше">−</button><output class="stepper__value" aria-live="polite">28 дн.</output><button type="button" class="icon-btn icon-btn--secondary" aria-label="Длина цикла по умолчанию: больше">+</button></div></div><div class="stepper"><span class="stepper__label">Длина месячных по умолчанию</span><div class="stepper__controls"><button type="button" class="icon-btn icon-btn--secondary" aria-label="Длина месячных по умолчанию: меньше">−</button><output class="stepper__value" aria-live="polite">5 дн.</output><button type="button" class="icon-btn icon-btn--secondary" aria-label="Длина месячных по умолчанию: больше">+</button></div></div><label class="toggle"><span>Учитывать личный сдвиг овуляции</span><input role="switch" type="checkbox"></label><label class="toggle"><span>Считать от следующей менструации</span><input role="switch" aria-describedby="ovulation-mode-hint" type="checkbox"></label><p id="ovulation-mode-hint" class="t-caption settings-card__hint">Овуляция будет рассчитана примерно за 14 дней до ожидаемого начала месячных</p></section><section class="card settings-card" aria-labelledby="entries-title"><h2 id="entries-title" class="t-card-title settings-card__title">Записи дня</h2><p class="t-caption settings-card__text">Включите то, что хотите отмечать в диалоге дня. Выключение ничего не удаляет — записи просто скрываются.</p><label class="toggle"><span>Самочувствие</span><input role="switch" type="checkbox"></label><label class="toggle"><span>Настроение<span class="t-small toggle__hint">Можно выбрать несколько</span></span><input role="switch" type="checkbox"></label><label class="toggle"><span>Отметка секса<span class="t-small toggle__hint">Сердечко в календаре</span></span><input role="switch" type="checkbox"></label><label class="toggle"><span>Заметки</span><input role="switch" type="checkbox"></label></section><section class="card settings-card" aria-labelledby="reminders-title"><h2 id="reminders-title" class="t-card-title settings-card__title">Напоминания</h2><p class="t-caption settings-card__text">Приходят в 12:00. На сервер уходят только даты и тексты напоминаний.</p><button type="button" class="btn btn--primary">Включить напоминания</button><label class="toggle"><span>За 2 дня до месячных<span class="t-small toggle__hint">Ближайшие дни будь аккуратна, скоро начало цикла</span></span><input role="switch" type="checkbox" checked=""></label><label class="toggle"><span>В день овуляции<span class="t-small toggle__hint">Сегодня Ты КОРОЛЕВА</span></span><input role="switch" type="checkbox" checked=""></label><label class="toggle"><span>Напоминать, если забыла отметить начало месячных<span class="t-small toggle__hint">Придёт на 3-й день после ожидаемого начала месячных, если оно не отмечено</span></span><input role="switch" type="checkbox" checked=""></label></section><section class="card settings-card" aria-labelledby="backup-title"><h2 id="backup-title" class="t-card-title settings-card__title">Резервная копия</h2><p class="t-caption settings-card__text">Данные хранятся только на этом телефоне. Сохраняйте копию в «Файлы», чтобы не потерять их при смене телефона.</p><button type="button" class="btn btn--primary">Экспорт</button><button type="button" class="btn">Импорт</button><input accept="application/json,.json,text/plain,.txt" hidden="" type="file"><dialog class="sheet" tabindex="-1" aria-label="Восстановить данные?"><div class="sheet__body"><div class="sheet__grip" aria-hidden="true"></div><div class="sheet__head"><h2 class="t-card-title sheet__title">Восстановить данные?</h2></div><button type="button" class="btn btn--primary">Восстановить</button><button type="button" class="btn btn--ghost">Отмена</button></div></dialog><dialog class="sheet" tabindex="-1" aria-label="Добавить месячные?"><div class="sheet__body"><div class="sheet__grip" aria-hidden="true"></div><div class="sheet__head"><h2 class="t-card-title sheet__title">Добавить месячные?</h2></div><button type="button" class="btn btn--primary">Добавить</button><button type="button" class="btn btn--ghost">Отмена</button></div></dialog></section><p class="t-small forecast-info"><button type="button" class="link-btn">Как считается прогноз</button></p><dialog class="sheet" tabindex="-1" aria-label="Как считается прогноз"><div class="sheet__body"><div class="sheet__grip" aria-hidden="true"></div><div class="sheet__head"><h2 class="t-card-title sheet__title">Как считается прогноз</h2></div><div class="t-body prose"><p>Длина цикла — среднее по последним 6 циклам (циклы короче 15 и длиннее 60 дней не учитываются). Пока истории нет, используется длина из настроек.</p><p>Овуляция — на 14-й день цикла, то есть через 13 дней после начала месячных, но не позже дня перед следующими месячными. Фертильное окно — 5 дней до овуляции и день овуляции. В дни отмеченных месячных окно не показывается.</p><p>Вероятность зачатия: высокая — в фертильное окно; средняя — 2 дня перед окном и день после овуляции; низкая — в остальные дни.</p><p>Если завершённых циклов меньше трёх или их длина различается больше чем на 7 дней, прогноз строится по средним значениям и может заметно ошибаться.</p></div><button type="button" class="btn">Понятно</button></div></dialog><button type="button" class="version">Версия X · test</button><p class="toast" role="status" aria-live="polite"></p>"`;
